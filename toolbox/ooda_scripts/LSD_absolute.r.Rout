> write.table(gstar2,"/data/cn5/caterina/Scripts/OODA/LSD_dependence_check_PDdata/LSD_absolute_gstarG2.txt",sep="\t",col.names=FALSE,row.names=FALSE)
> blockCuts <- c(29, 35, 74, 91, 127, 129, 137, 174, 192, 195, 214, 241, 251, 257, 266, 270)
> labels <- c("MotorHand", "MotorMouth", "CingOperc", "Auditory", "Default", "PERN", "RetroSpl", "Visual", "FrontoPar", "Salience", "VentAttn", "DorsalAttn", "Thal", "BG", "Reward", "MTL", "Cerebellum" )
