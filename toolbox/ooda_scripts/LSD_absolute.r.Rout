> group1 <- read.table("/data/cn5/caterina/Scripts/OODA/LSD_dependence_check_PDdata/LSD_absolutegroup1.txt")
> group2 <- read.table("/data/cn5/caterina/Scripts/OODA/LSD_dependence_check_PDdata/LSD_absolutegroup2.txt")
